{
  "manifest_version": 3,
  "name": "Fixr Ticket Monitor",
  "version": "1.0.0",
  "description": "Real-time Fixr event ticket monitoring with auto-login and basket add",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://fixr.co/*",
    "https://api.fixr.co/*",
    "https://ntfy.sh/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fixr Monitor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://fixr.co/*"],
      "js": ["content/autologin.js", "content/add-to-basket.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": []
}
